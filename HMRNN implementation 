        "    def __init__(self, vocab_size, hidden_size=32):\n",
        "        super().__init__()\n",
        "        self.embedding = nn.Embedding(vocab_size, hidden_size)\n",
        "        self.rnn_cell = HMLSTMCell(hidden_size, hidden_size)\n",
        "        self.fc = nn.Linear(hidden_size, vocab_size)\n",
        "\n",
        "    def forward(self, x):\n",
        "        batch_size, seq_len = x.shape\n",
        "        h = torch.zeros(batch_size, self.rnn_cell.hidden_size)\n",
        "        c = torch.zeros(batch_size, self.rnn_cell.hidden_size)\n",
