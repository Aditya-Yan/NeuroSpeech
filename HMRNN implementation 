        "def predict(model, start=\"the\", length=20):\n",
        "    model.eval()\n",
        "    x = torch.tensor([stoi[ch] for ch in start], dtype=torch.long).unsqueeze(0)\n",
        "    h_text = start\n",
        "    with torch.no_grad():\n",
        "        for _ in range(length):\n",
        "            outputs = model(x)\n",
        "            next_char = outputs[0, -1].argmax().item()\n",
        "            h_text += itos[next_char]\n",
        "            x = torch.tensor([[next_char]])\n",
        "    return h_text\n",
        "\n",
        "print(predict(model, start=\"the \"))\n"
