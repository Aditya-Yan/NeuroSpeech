        "class HMLSTMCell(nn.Module):\n",
        "    def __init__(self, input_size, hidden_size):\n",
        "        super().__init__()\n",
        "        self.hidden_size = hidden_size\n",
        "        self.linear = nn.Linear(input_size + hidden_size, 4*hidden_size + 1)\n",
        "\n",
        "    def forward(self, x, h_prev, c_prev, z_prev, z_below=1):\n",
        "        combined = torch.cat([x, h_prev], dim=-1)\n",
        "        gates = self.linear(combined)\n",
        "\n",
        "        f, i, o, g, z_tilde = torch.split(gates, [self.hidden_size]*4 + [1], dim=-1)\n",
        "        f, i, o = torch.sigmoid(f), torch.sigmoid(i), torch.sigmoid(o)\n",
        "        g = torch.tanh(g)\n",
        "\n",
        "        # Boundary detector (straight-through estimator idea)\n",
        "        z_t = (torch.sigmoid(z_tilde) > 0.5).float()\n",
        "\n",
        "        if z_prev == 0 and z_below == 0:  # COPY\n",
        "            h, c = h_prev, c_prev\n",
        "        elif z_prev == 0 and z_below == 1:  # UPDATE\n",
        "            c = f * c_prev + i * g\n",
        "            h = o * torch.tanh(c)\n",
        "        elif z_prev == 1:  # FLUSH\n",
        "            c = i * g\n",
        "            h = o * torch.tanh(c)\n",
        "\n",
        "        return h, c, z_t\n"
