      "source": [
        "train_text = \"the cat sat on the mat\"\n",
        "valid_text = \"the dog sat\"\n",
        "test_text  = \"the cat\"\n",
        "\n",
        "# Build vocabulary (unique characters)\n",
        "vocab = sorted(set(train_text + valid_text + test_text))\n",
        "stoi = {ch: i for i, ch in enumerate(vocab)}  # char → int\n",
        "itos = {i: ch for ch, i in stoi.items()}      # int → char\n",
        "\n",
        "def encode(s): return [stoi[ch] for ch in s]\n",
        "def decode(ids): return \"\".join([itos[i] for i in ids])\n",
        "\n",
        "train_data = torch.tensor(encode(train_text), dtype=torch.long)\n",
        "valid_data = torch.tensor(encode(valid_text), dtype=torch.long)\n",
        "test_data  = torch.tensor(encode(test_text), dtype=torch.long)\n"
