        "            emb = self.embedding(x[:, t])\n",
        "            h, c, z = self.rnn_cell(emb, h, c, z)\n",
        "            outputs.append(self.fc(h))\n",
        "\n",
        "        return torch.stack(outputs, dim=1)\n"
