        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class HMLSTMCell(nn.Module):\n",
        "    def __init__(self, input_size, hidden_size):\n",
        "        super().__init__()\n",
        "        self.hidden_size = hidden_size\n",
        "        # Linear layer produces 4 gates + 1 boundary signal\n",
        "        self.linear = nn.Linear(input_size + hidden_size, 4*hidden_size + 1)\n",
        "\n",
        "    def forward(self, x, h_prev, c_prev, z_prev, z_below=None):\n",
        "        if z_below is None:\n",
        "            z_below = torch.ones_like(z_prev)  # assume active if not provided\n",
        "\n",
        "        # Combine input + hidden\n",
        "        combined = torch.cat([x, h_prev], dim=-1)\n",
        "        gates = self.linear(combined)\n",
        "\n",
        "        f, i, o, g, z_tilde = torch.split(\n",
        "            gates, [self.hidden_size]*4 + [1], dim=-1\n",
        "        )\n",
        "        f, i, o = torch.sigmoid(f), torch.sigmoid(i), torch.sigmoid(o)\n",
        "        g = torch.tanh(g)\n",
        "\n",
        "        # Boundary detector (straight-through)\n",
        "        z_t = (torch.sigmoid(z_tilde) > 0.5).float()\n",
        "\n",
        "        # Start with COPY by default\n",
        "        h, c = h_prev.clone(), c_prev.clone()\n",
        "\n",
        "        # Masks\n",
        "        update_mask = (z_prev == 0) & (z_below == 1)\n",
        "        flush_mask  = (z_prev == 1)\n",
        "\n",
        "        # UPDATE\n",
        "        if update_mask.any():\n",
        "            idx = update_mask.squeeze()\n",
        "            c[idx] = f[idx] * c_prev[idx] + i[idx] * g[idx]\n",
        "            h[idx] = o[idx] * torch.tanh(c[idx])\n",
        "\n",
        "        # FLUSH\n",
        "        if flush_mask.any():\n",
        "            idx = flush_mask.squeeze()\n",
        "            c[idx] = i[idx] * g[idx]\n",
        "            h[idx] = o[idx] * torch.tanh(c[idx])\n",
        "\n",
        "        return h, c, z_t\n"
      ],
